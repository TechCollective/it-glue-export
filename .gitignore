# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/
ENV/

# Environment configuration and credentials
.env
*.json
!requirements.txt  # Ensure we don't accidentally ignore json configurations that are needed, but service-account.json should be ignored. Actually, it's safer to specify service-account.json or similar.
# Let's specify exact credential files to ignore:
service-account.json
credentials.json

# Temporary files and backup/export outputs
temp/
*.zip
*.log
