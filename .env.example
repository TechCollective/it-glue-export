# IT Glue Configuration
ITGLUE_API_KEY=your_itglue_api_key_here
# EU region: https://api.eu.itglue.com, US region: https://api.itglue.com
ITGLUE_API_ENDPOINT=https://api.itglue.com
# Optional: password to encrypt the backup zip file (highly recommended)
ITGLUE_ZIP_PASSWORD=your_secure_zip_password_here
# Optional: limit backup to a single organization ID (leave empty for full account export)
ITGLUE_ORG_ID=
# Optional: include account activity logs (true/false)
ITGLUE_INCLUDE_LOGS=false
# Optional: include passwords in export (true/false, defaults to true)
ITGLUE_INCLUDE_PASSWORDS=true

# Google Drive Configuration
# Path to your Google Drive service account credentials JSON file (e.g., service-account.json)
GDRIVE_CREDENTIALS_FILE=service-account.json
# Google Drive Folder ID where the backup zip file will be uploaded
GDRIVE_FOLDER_ID=your_gdrive_folder_id_here

# Local Storage Configuration
# Directory to temporarily store the downloaded ZIP file before uploading
LOCAL_TEMP_DIR=./temp
